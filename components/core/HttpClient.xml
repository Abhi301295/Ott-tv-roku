<?xml version="1.0" encoding="utf-8" ?>
<!-- App-wide HTTP client: owns the keep-alive worker pool + dispatch queue.
     Declared as the first child of MainScene so it exists before any boot request,
     and also registers itself on m.global for lazy access from anywhere. -->
<component name="HttpClient" extends="Node">
  <interface>
    <function name="Submit" />
    <function name="WarmAll" />
    <!-- Drop queued (not yet dispatched) requests on screen replace so a fast nav
         (e.g. Home → Movies) does not let stale boot fetches starve the foreground. -->
    <function name="ClearQueue" />
  </interface>

  <script type="text/brightscript" uri="pkg:/source/lib/net/Config.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Routes.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Navigation.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Registry.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/net/SessionInterceptor.brs" />
  <script type="text/brightscript" uri="pkg:/components/core/HttpClient.brs" />
</component>
