<?xml version="1.0" encoding="utf-8" ?>
<!-- Fetches an HLS master playlist and parses its variant ladder so the player can show
     real quality options (Roku's Video node does not expose the HLS levels). One-shot:
     set manifestUrl, control="RUN", then observe `levels`. -->
<component name="ManifestTask" extends="Task">
  <interface>
    <field id="manifestUrl" type="string" />
    <field id="httpCookies" type="string" />
    <field id="levels" type="array" />
    <field id="firstMediaUrl" type="string" />
    <field id="isHlsManifest" type="boolean" value="false" />
    <field id="fetchStatus" type="integer" value="0" />
    <field id="resolvedUrl" type="string" />
    <field id="streamFormat" type="string" />
    <field id="resolvePath" type="string" alwaysNotify="true" />
    <field id="forceProbe" type="boolean" value="false" />
    <field id="done" type="boolean" value="false" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/lib/video/TrailerResolver.brs" />
  <script type="text/brightscript" uri="pkg:/components/core/ManifestTask.brs" />
</component>
