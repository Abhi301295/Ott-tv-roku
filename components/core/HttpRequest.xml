<?xml version="1.0" encoding="utf-8" ?>
<!-- A single HTTP request handle. Created by ApiClient (ApiGet/ApiPost/…), handed to
     the HttpClient pool, and populated by a worker. Field-identical to the old
     HttpTask interface so call sites keep observing apiResult exactly as before. -->
<component name="HttpRequest" extends="Node">
  <interface>
    <field id="method" type="string" value="GET" />
    <field id="path" type="string" />
    <field id="body" type="string" />
    <field id="responseText" type="string" alwaysNotify="true" />
    <field id="apiResult" type="assocarray" alwaysNotify="true" />
    <field id="httpStatus" type="integer" alwaysNotify="true" />
    <field id="errorMessage" type="string" alwaysNotify="true" />
    <field id="shouldLogout" type="boolean" alwaysNotify="true" />
  </interface>
</component>
