<?xml version="1.0" encoding="utf-8" ?>
<component name="HttpTask" extends="Task">
  <interface>
    <field id="method" type="string" value="GET" />
    <field id="path" type="string" />
    <field id="body" type="string" />
    <field id="responseText" type="string" alwaysNotify="true" />
    <field id="apiResult" type="assocarray" alwaysNotify="true" />
    <field id="httpStatus" type="integer" alwaysNotify="true" />
    <field id="errorMessage" type="string" alwaysNotify="true" />
    <field id="shouldLogout" type="boolean" alwaysNotify="true" />
  </interface>

  <script type="text/brightscript" uri="pkg:/source/lib/net/Config.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/net/Endpoints.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Registry.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/net/AuthInterceptor.brs" />
  <script type="text/brightscript" uri="pkg:/components/core/HttpTask.brs" />
</component>
