<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
  <interface>
    <field id="launchArgs" type="assocarray" />
    <!-- Global toast (parity with showAlert). Any screen sets alertMessage via ShowAlert(). -->
    <field id="alertMessage" type="string" alwaysNotify="true" />
    <field id="alertType" type="integer" value="2" />
    <!-- Set true to exit the channel; main.brs observes this and closes roSGScreen. -->
    <field id="exitChannel" type="boolean" value="false" alwaysNotify="true" />
  </interface>

  <script type="text/brightscript" uri="pkg:/source/lib/net/Config.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/theme/BusinessConfig.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/telemetry/TelemetryService.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Routes.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Registry.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Navigation.brs" />
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />

  <children>
    <Rectangle id="bootBg" width="1920" height="1080" color="0x0b1120" />
    <ThemeManager id="themeManager" />
    <ViewManager id="viewManager" visible="false" />
    <TelemetryClient id="telemetryClient" />

    <!-- Last child = top z-order; toast floats above all screens. Parity with Toast:
         bg rgba(40,40,40,0.7), rounded-8, px-30 py-15, 22px text, circle-X icon (mr-10),
         content-hugging width centered at top (geometry computed in ShowGlobalToast). -->
    <Group id="toastBanner" translation="[460, 30]" visible="false">
      <Poster id="toastCapL" translation="[0, 0]" width="20" height="60"
        uri="pkg:/images/ui/toast_cap_left.png" blendColor="0x282828ff" opacity="0.7" />
      <Rectangle id="toastMid" translation="[20, 0]" width="100" height="60" color="0x282828b3" />
      <Poster id="toastCapR" translation="[120, 0]" width="20" height="60"
        uri="pkg:/images/ui/toast_cap_right.png" blendColor="0x282828ff" opacity="0.7" />
      <Poster id="toastCross" translation="[30, 20]" width="20" height="20"
        uri="pkg:/images/ui/toast_cross.png" blendColor="0x0b75e0ff" />
      <Label id="toastLabel" translation="[60, 0]" height="60" horizAlign="left"
        vertAlign="center" color="0xfafafaff" text="">
        <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="22" />
      </Label>
    </Group>
    <Timer id="alertTimer" duration="3" repeat="false" />
  </children>
</component>
