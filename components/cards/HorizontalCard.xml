<?xml version="1.0" encoding="utf-8" ?>
<!-- Horizontal content card — parity with components/cards/horizontalCard.tsx (540×312). -->
<component name="HorizontalCard" extends="Group">
  <interface>
    <field id="thumbnailUri" type="string" value="" onChange="OnDataChanged" />
    <field id="focusedState" type="boolean" value="false" onChange="OnFocusChanged" />
    <field id="cPrimary500" type="string" value="0x0b75e0ff" onChange="OnThemeChanged" />
    <field id="cPrimary700" type="string" value="0x04478bff" onChange="OnThemeChanged" />
    <field id="cNeutral700" type="string" value="0x404040ff" onChange="OnThemeChanged" />
    <field id="cNeutral800" type="string" value="0x262626ff" onChange="OnThemeChanged" />
  </interface>

  <script type="text/brightscript" uri="pkg:/source/lib/theme/SkeletonConfig.brs" />
  <script type="text/brightscript" uri="pkg:/components/cards/CardCommon.brs" />
  <script type="text/brightscript" uri="pkg:/components/cards/HorizontalCard.brs" />

  <children>
    <Group id="body" translation="[3, 3]">
      <Skeleton id="skeleton" boxWidth="540" boxHeight="312" />
      <Rectangle id="thumbFallback" width="540" height="312" color="0xffffff1a" visible="false" />
      <Poster id="thumbFallbackLogo" width="220" height="128" loadDisplayMode="scaleToFit" opacity="0.35" visible="false" />
      <Poster id="thumb" width="540" height="312" loadWidth="540" loadHeight="312" loadDisplayMode="scaleToFill" visible="false" />
      <!-- Rounded corners (radius-10) — baked corner covers; MaskGroup doesn't clip in sim.
           Shared round_corner_*.png (#0a0a0a). -->
      <Poster id="cornerTL" uri="pkg:/images/ui/round_corner_tl.png" translation="[0, 0]"   width="10" height="10" />
      <Poster id="cornerTR" uri="pkg:/images/ui/round_corner_tr.png" translation="[530, 0]" width="10" height="10" />
      <Poster id="cornerBL" uri="pkg:/images/ui/round_corner_bl.png" translation="[0, 302]" width="10" height="10" />
      <Poster id="cornerBR" uri="pkg:/images/ui/round_corner_br.png" translation="[530, 302]" width="10" height="10" />
    </Group>
    <!-- Focus frame (546×318) is created lazily on first focus — see ApplyFocusVisual. -->
  </children>
</component>
