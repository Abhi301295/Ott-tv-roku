<?xml version="1.0" encoding="utf-8" ?>
<!-- Continue-watching card — parity with continueWatchCard.tsx (540×286 + progress bar). -->
<component name="ContinueWatchCard" extends="Group">
  <interface>
    <field id="thumbnailUri" type="string" value="" onChange="OnDataChanged" />
    <field id="progress" type="float" value="0.0" onChange="OnDataChanged" />
    <field id="focusedState" type="boolean" value="false" onChange="OnFocusChanged" />
    <field id="loaded" type="boolean" value="false" alwaysNotify="true" />
    <field id="cPrimary500" type="string" value="0x0b75e0ff" onChange="OnThemeChanged" />
    <field id="cPrimary600" type="string" value="0x0760bbff" onChange="OnThemeChanged" />
    <field id="cPrimary700" type="string" value="0x04478bff" onChange="OnThemeChanged" />
    <field id="cNeutral700" type="string" value="0x404040ff" onChange="OnThemeChanged" />
    <field id="cNeutral800" type="string" value="0x262626ff" onChange="OnThemeChanged" />
    <field id="cNeutral950" type="string" value="0x0a0a0aff" onChange="OnThemeChanged" />
  </interface>

  <script type="text/brightscript" uri="pkg:/components/cards/CardCommon.brs" />
  <script type="text/brightscript" uri="pkg:/components/cards/ContinueWatchCard.brs" />

  <children>
    <Group id="body" translation="[3, 3]">
      <Skeleton id="skeleton" boxWidth="540" boxHeight="286" />
      <Poster id="thumb" width="540" height="286" loadWidth="540" loadHeight="286" loadDisplayMode="scaleToFill" visible="false" />
      <Rectangle id="progressTrack" translation="[0, 278]" width="540" height="8" color="0x0a0a0aff" />
      <!-- 3-segment fill approximates React's from-primary-500 via-600 to-700 gradient
           while staying theme-token driven (widths/colors set in code). -->
      <Rectangle id="progressFillA" translation="[0, 278]" width="0" height="8" color="0x0b75e0ff" />
      <Rectangle id="progressFillB" translation="[0, 278]" width="0" height="8" color="0x0760bbff" />
      <Rectangle id="progressFillC" translation="[0, 278]" width="0" height="8" color="0x04478bff" />
      <!-- Simulator-safe rounding: MaskGroup is not honored here, so these tuned corner
           covers hide the square thumbnail/progress corners while the row background remains
           transparent. Color matches the hero bottom vignette to avoid hard black notches. -->
      <Poster id="maskTL" uri="pkg:/images/ui/round_mask_tl.png" translation="[0, 0]"
        width="12" height="12" />
      <Poster id="maskTR" uri="pkg:/images/ui/round_mask_tr.png" translation="[528, 0]"
        width="12" height="12" />
      <Poster id="maskBL" uri="pkg:/images/ui/round_mask_bl.png" translation="[0, 274]"
        width="12" height="12" />
      <Poster id="maskBR" uri="pkg:/images/ui/round_mask_br.png" translation="[528, 274]"
        width="12" height="12" />
    </Group>
    <!-- Focus frame (546×292 = 540×286 + 3px each side) is created lazily on first focus
         (see ApplyFocusVisual) so it isn't built for every card during the row build burst. -->
  </children>
</component>
