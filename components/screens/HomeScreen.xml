<?xml version="1.0" encoding="utf-8" ?>
<!-- Home screen — Netflix-layout content rows (home-rows). Data boot mirrors
     features/home/index.tsx; rows mirror netflixContent.tsx + contentRow.tsx. -->
<component name="HomeScreen" extends="Group">
  <interface>
    <field id="navState" type="assocarray" onChange="OnNavStateReady" />
    <field id="keyEvent" type="assocarray" alwaysNotify="true" />
    <field id="shellEnterContent" type="boolean" value="false" alwaysNotify="true" onChange="OnShellEnterContent" />
    <field id="shellEnterAction" type="string" value="" />
    <!-- Set by ViewManager right before this screen is removed, so we can stop the hero
         carousel + build timers (prevents orphaned auto-rotating heroes). -->
    <field id="dispose" type="boolean" value="false" onChange="OnDispose" />
  </interface>

  <script type="text/brightscript" uri="pkg:/source/lib/Routes.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Registry.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Alert.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/net/Endpoints.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/net/Config.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/net/ApiClient.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/login/NextStep.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/login/LoginStrings.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Navigation.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/login/LoginService.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/profile/ProfileService.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/profile/ProfileStrings.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/profile/ProfileSelectTrace.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/profile/ProfileTransition.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/theme/ThemeConfig.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/theme/BusinessConfig.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/home/HomeConstants.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/home/HomeBootCache.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/home/HomeService.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/home/HomePerf.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/home/CardHelper.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/home/HeaderMenu.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/home/HeaderSidebarMenu.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/home/HomeNav.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/debug/OttDebug.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/browse/BrowseDebug.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/theme/ColorShade.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/theme/SkeletonConfig.brs" />
  <script type="text/brightscript" uri="pkg:/components/cards/CardCommon.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/theme/ThemeConfig.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Navigation.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/shell/AppShell.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/HomeScreen.brs" />

  <children>
    <Rectangle id="bg" width="1920" height="1080" color="0x0a0a0aff" />

    <HeroBannerHost id="hero" translation="[0, 0]" visible="false" />

    <!-- Row backdrop is intentionally transparent; HomeSkeleton/row shimmers cover loading
         state while the hero remains visible behind the content rows, matching LG. -->
    <Poster id="rowsScrimGrad" uri="pkg:/images/ui/grad_bottom.png" translation="[0, 600]"
      width="1920" height="70" loadDisplayMode="scaleToFill" opacity="0.0" />
    <Rectangle id="rowsScrim" translation="[0, 668]" width="1920" height="412"
      color="0x0a0a0aff" opacity="0.0" />

    <Group id="rowsHost" translation="[0, 702]" visible="false" />

    <Animation id="rowsAnim" duration="0.4" repeat="false" easeFunction="inOutCubic">
      <Vector2DFieldInterpolator id="rowsInterp" key="[0.0, 1.0]"
        fieldToInterp="rowsHost.translation" />
    </Animation>

    <Animation id="layoutAnim" duration="0.3" repeat="false" easeFunction="inOutCubic">
      <Vector2DFieldInterpolator id="heroLayoutInterp" key="[0.0, 1.0]"
        fieldToInterp="hero.translation" />
      <Vector2DFieldInterpolator id="rowsLayoutInterp" key="[0.0, 1.0]"
        fieldToInterp="rowsHost.translation" />
      <Vector2DFieldInterpolator id="scrimGradLayoutInterp" key="[0.0, 1.0]"
        fieldToInterp="rowsScrimGrad.translation" />
      <Vector2DFieldInterpolator id="scrimLayoutInterp" key="[0.0, 1.0]"
        fieldToInterp="rowsScrim.translation" />
      <Vector2DFieldInterpolator id="skeletonLayoutInterp" key="[0.0, 1.0]"
        fieldToInterp="homeSkeleton.translation" />
    </Animation>

    <HomeSkeleton id="homeSkeleton" visible="true" />

    <!-- Direct header nodes live on ViewManager appHeader (PageContainer parity). -->
  </children>
</component>
