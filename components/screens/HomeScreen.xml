<?xml version="1.0" encoding="utf-8" ?>
<!-- Home screen — data boot + card widget preview (home-data / home-cards).
     Fetches mirror features/home/index.tsx; card samples render per row type until
     home-rows wires full RowList scrolling. -->
<component name="HomeScreen" extends="Group">
  <interface>
    <field id="navState" type="assocarray" />
    <field id="keyEvent" type="assocarray" alwaysNotify="true" />
  </interface>

  <script type="text/brightscript" uri="pkg:/source/lib/Routes.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Registry.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Alert.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/net/Endpoints.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/net/Config.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/net/ApiClient.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/login/NextStep.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/login/LoginStrings.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/login/LoginService.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/profile/ProfileService.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/home/HomeConstants.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/home/HomeService.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/home/CardHelper.brs" />
  <script type="text/brightscript" uri="pkg:/components/cards/CardCommon.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/HomeScreen.brs" />

  <children>
    <Rectangle id="bg" width="1920" height="1080" color="0x141414ff" />

    <Label id="logoLabel" text="OTT Accelerator" translation="[120, 48]" width="600"
      color="0x0b75e0ff">
      <Font role="font" uri="pkg:/fonts/DMSans-Bold.ttf" size="30" />
    </Label>

    <Label id="statusLabel" text="" translation="[120, 110]" width="1680" height="28"
      color="0x9ea4b0ff" visible="false">
      <Font role="font" uri="pkg:/fonts/DMSans-Regular.ttf" size="20" />
    </Label>

    <Label id="dataLabel" text="" translation="[120, 150]" width="1680" height="100"
      color="0xf8f1f7ff" wrap="true" visible="false">
      <Font role="font" uri="pkg:/fonts/DMSans-Regular.ttf" size="18" />
    </Label>

    <Group id="cardsContainer" translation="[120, 280]" visible="false" />

    <Group id="bootOverlay" visible="true">
      <Rectangle width="1920" height="1080" color="0x141414ff" />
      <BusySpinner id="bootSpinner" translation="[936, 486]" spinInterval="1" visible="true">
        <Poster role="poster" uri="pkg:/images/ui/loader_spinner.png" width="48" height="48" />
      </BusySpinner>
      <Label text="Loading" translation="[760, 548]" width="400" height="32"
        horizAlign="center" vertAlign="center" color="0xf8f1f7ff">
        <Font role="font" uri="pkg:/fonts/DMSans-Regular.ttf" size="22" />
      </Label>
    </Group>
  </children>
</component>
