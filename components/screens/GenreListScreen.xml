<?xml version="1.0" encoding="utf-8" ?>
<!-- Movies / Series catalogue — parity with src/features/genre-list/ -->
<component name="GenreListScreen" extends="Group">
  <interface>
    <field id="navState" type="assocarray" onChange="OnNavStateReady" />
    <field id="keyEvent" type="assocarray" alwaysNotify="true" />
    <field id="dispose" type="boolean" value="false" onChange="OnDispose" />
  </interface>

  <script type="text/brightscript" uri="pkg:/source/lib/Routes.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Registry.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Alert.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/net/Endpoints.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/net/Config.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/net/ApiClient.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/login/NextStep.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/login/LoginStrings.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/login/LoginService.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/theme/BusinessConfig.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/theme/ColorShade.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/home/HomeConstants.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/home/CardHelper.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/home/HeaderMenu.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/home/HomeNav.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/browse/BrowseConstants.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/browse/GenreListService.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/browse/GenreNav.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/browse/BrowseDebug.brs" />
  <script type="text/brightscript" uri="pkg:/components/cards/CardCommon.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/GenreListScreen.brs" />

  <children>
    <Rectangle id="bg" width="1920" height="1080" color="0x0a0a0aff" />

    <HeroBannerOtt id="hero" translation="[0, 0]" visible="true" contentWidth="1920" />
    <GenreListSkeleton id="genreSkeleton" visible="false" />

    <Group id="rowsHost" translation="[0, 594]" visible="false" />

    <Animation id="rowsAnim" duration="0.4" repeat="false" easeFunction="inOutCubic">
      <Vector2DFieldInterpolator id="rowsInterp" key="[0.0, 1.0]"
        fieldToInterp="rowsHost.translation" />
    </Animation>

    <Label id="emptyLabel" translation="[360, 420]" width="1200" height="80" wrap="true"
      horizAlign="center" vertAlign="center" visible="false" color="0xf5f5f5ff"
      text="We are sorry, we can not find the content">
      <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="43" />
    </Label>

    <Timer id="rowBuildTimer" duration="0.01" repeat="true" />
    <Timer id="heroSkeletonTimeout" duration="5.0" repeat="false" />
    <Timer id="rowsSkeletonTimeout" duration="8.0" repeat="false" />
  </children>
</component>
