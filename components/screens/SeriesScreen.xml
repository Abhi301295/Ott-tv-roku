  <script type="text/brightscript" uri="pkg:/components/screens/SeriesScreen.brs" />

  <children>
    <Rectangle id="bg" width="1920" height="1080" color="0x000000ff" />

    <Group id="contentHost">
      <Label id="titleLabel" translation="[56, 72]" width="1700" height="56" wrap="false"
        color="0xf5f5f5ff" text="">
        <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="43" />
      </Label>

      <Group id="rowsHost" translation="[56, 162]" clippingRect="[0, 0, 1808, 900]" />

      <Animation id="vScrollAnim" duration="0.35" repeat="false" easeFunction="inOutCubic">
        <Vector2DFieldInterpolator id="vScrollInterp" key="[0.0, 1.0]"
          fieldToInterp="rowsHost.translation" />
      </Animation>
      <Animation id="hScrollAnim" duration="0.28" repeat="false" easeFunction="inOutCubic">
        <Vector2DFieldInterpolator id="hScrollInterp" key="[0.0, 1.0]"
          fieldToInterp="rowsHost.translation" />
      </Animation>
    </Group>

    <!-- series/index.tsx inside PageContainer bg-black + Spinner -->
    <Group id="loaderHost" translation="[0, 0]" visible="false">
      <Rectangle id="loaderPageBg" width="1920" height="1080" color="0x00000000" visible="false" />
      <Group id="loaderCenter" translation="[960, 518]">
        <HomeLoader id="pageLoader" />
      </Group>
    </Group>

    <Label id="emptyLabel" translation="[360, 420]" width="1200" height="80" wrap="true"
      horizAlign="center" vertAlign="center" visible="false" color="0x404040ff"
      text="We are sorry, we can not find the content">
      <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="43" />
    </Label>
  </children>
