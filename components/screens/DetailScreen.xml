<?xml version="1.0" encoding="utf-8" ?>
<!-- Content detail — parity with src/features/contentdetail/index.tsx -->
<component name="DetailScreen" extends="Group">
  <interface>
    <field id="navState" type="assocarray" onChange="OnNavStateReady" />
    <field id="keyEvent" type="assocarray" alwaysNotify="true" />
    <field id="dispose" type="boolean" value="false" onChange="OnDispose" />
  </interface>

  <script type="text/brightscript" uri="pkg:/source/lib/Routes.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Registry.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Alert.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/net/Endpoints.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/net/Config.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/net/ApiClient.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/login/NextStep.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/login/LoginStrings.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Navigation.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/login/LoginService.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/theme/BusinessConfig.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/home/HomeConstants.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/browse/BrowseConstants.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/home/CardHelper.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/home/HeaderMenu.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/detail/DetailStrings.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/detail/DetailService.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/video/VideoService.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/theme/ColorShade.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/theme/SkeletonConfig.brs" />
  <script type="text/brightscript" uri="pkg:/components/cards/CardCommon.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/DetailScreen.brs" />

  <children>
    <Rectangle id="bg" width="1920" height="1080" color="0x0a0a0aff" />

    <!-- Backdrop banner + cinematic scrims (parity with contentdetail/index.tsx).
         Banner uses scaleToZoom (= CSS bg-cover) so the art stays sharp; gradients only
         cover the left 55% and bottom 20% so the right side stays crystal clear. -->
    <Poster id="banner" width="1920" height="1080" loadWidth="2560" loadHeight="1440"
      loadDisplayMode="scaleToZoom" visible="false" />
    <!-- after:from-black/95 to-transparent to-[55%] — vignette ends at 55% width. -->
    <Poster id="gradLeft" uri="pkg:/images/ui/grad_left.png" width="1056" height="1080"
      loadDisplayMode="scaleToFill" visible="false" />
    <!-- bg-gradient-to-t from-black/85 to-transparent to-[20%] — bottom 216px only. -->
    <Poster id="gradBottom" uri="pkg:/images/ui/grad_bottom.png" translation="[0, 864]"
      width="1920" height="216" loadDisplayMode="scaleToFill" opacity="0.85" visible="false" />

    <!-- Loading shimmer — parity with the detail skeleton (neutral-700 boxes, animate-pulse).
         Positions track the real content below so the hand-off is seamless. -->
    <Group id="skeletonGroup" visible="false">
      <!-- Each shape is a native-size PNG (1:1). brs-engine does NOT stretch 9-patches. -->
      <Skeleton id="skTitle" translation="[50, 340]" boxWidth="400" boxHeight="80"
        shapeUri="pkg:/images/ui/sk_detail_title.png" />
      <Skeleton id="skRateNum" translation="[50, 432]" boxWidth="40" boxHeight="40"
        shapeUri="pkg:/images/ui/sk_detail_rate.png" />
      <Skeleton id="skStar0" translation="[100, 440]" boxWidth="24" boxHeight="24"
        shapeUri="pkg:/images/ui/sk_detail_dot.png" />
      <Skeleton id="skStar1" translation="[132, 440]" boxWidth="24" boxHeight="24"
        shapeUri="pkg:/images/ui/sk_detail_dot.png" />
      <Skeleton id="skStar2" translation="[164, 440]" boxWidth="24" boxHeight="24"
        shapeUri="pkg:/images/ui/sk_detail_dot.png" />
      <Skeleton id="skStar3" translation="[196, 440]" boxWidth="24" boxHeight="24"
        shapeUri="pkg:/images/ui/sk_detail_dot.png" />
      <Skeleton id="skStar4" translation="[228, 440]" boxWidth="24" boxHeight="24"
        shapeUri="pkg:/images/ui/sk_detail_dot.png" />
      <Skeleton id="skDesc0" translation="[50, 500]" boxWidth="1116" boxHeight="20"
        shapeUri="pkg:/images/ui/sk_detail_line_1116.png" />
      <Skeleton id="skDesc1" translation="[50, 532]" boxWidth="1060" boxHeight="20"
        shapeUri="pkg:/images/ui/sk_detail_line_1060.png" />
      <Skeleton id="skDesc2" translation="[50, 564]" boxWidth="948" boxHeight="20"
        shapeUri="pkg:/images/ui/sk_detail_line_948.png" />
      <Skeleton id="skBtn1" translation="[60, 620]" boxWidth="500" boxHeight="60"
        shapeUri="pkg:/images/ui/sk_detail_btn.png" />
      <Skeleton id="skBtn2" translation="[60, 700]" boxWidth="500" boxHeight="60"
        shapeUri="pkg:/images/ui/sk_detail_btn.png" />
    </Group>

    <Group id="contentHost" visible="false">
      <!-- Title — fw-800 fs-50 lh-60 (×1.2 = 60px), neutral-50, ls 0.02em (~1.2px), m-b-10.
           Height must clear the ~72px line box or a 60px line won't fit and renders blank. -->
      <Label id="titleLabel" translation="[50, 336]" width="1000" height="80" wrap="true"
        maxLines="1" color="0xf5f5f5ff">
        <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="60" />
      </Label>

      <!-- Rating: number (fs-20 fw-700 → 24px) + themed stars. Sits 10px under the title. -->
      <Group id="ratingHost" translation="[50, 410]">
        <Label id="ratingLabel" text="" width="44" height="32" vertAlign="center" color="0xf5f5f5ff">
          <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="24" />
        </Label>
      </Group>

      <!-- Discretion • genres (fw-600 fs-24 → ×1.2 = 29), neutral-300. Directly under rating. -->
      <Label id="metaLabel" translation="[50, 446]" width="1400" height="40" wrap="false"
        color="0xadadadff">
        <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="29" />
      </Label>

      <!-- Description fw-400 fs-22 lh-36 (×1.2 = 26px), clamp 3 lines, neutral-300, m-y-12. -->
      <Label id="descLabel" translation="[50, 498]" width="1116" height="110" wrap="true"
        maxLines="3" lineSpacing="10" color="0xadadadff">
        <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="26" />
      </Label>

      <Group id="actionsHost" translation="[60, 620]">
        <DetailActionButton id="watchNowBtn" label="Watch Now" translation="[0, 0]"
          alwaysBg="true" iconUri="pkg:/images/ui/ic_play.png" iconW="18" iconH="21" />
        <DetailActionButton id="moreEpisodesBtn" label="More Episodes" translation="[0, 92]"
          iconUri="pkg:/images/ui/ic_startover.png" iconW="21" iconH="21" visible="false" />
        <DetailActionButton id="watchlistBtn" label="Add to Watchlist" translation="[0, 184]"
          iconUri="pkg:/images/ui/ic_bookmark.png" iconW="18" iconH="21" />
        <DetailActionButton id="moreLikeBtn" label="More Like This" translation="[0, 276]"
          iconUri="pkg:/images/ui/ic_series.png" iconW="25" iconH="25" />
        <DetailActionButton id="trailerBtn" label="Trailer &amp; More Info" translation="[0, 368]"
          iconUri="pkg:/images/ui/ic_series.png" iconW="25" iconH="25" visible="false" />
      </Group>
    </Group>

    <!-- More Like This overlay — dims the live detail UI; drawer slides up smoothly. -->
    <Group id="moreLikeOverlay" visible="false">
      <Rectangle id="moreLikeScrim" width="1920" height="1080" color="0x000000ff" opacity="0" />
      <Group id="moreLikeDrawer" translation="[0, 1080]">
        <Group id="moreLikeCardsHost" translation="[40, 612]" />
        <!-- 8 shimmer placeholders — parity with React w-272 h-340 bg-neutral-700 animate-pulse. -->
        <Group id="moreLikeSkeletonHost" translation="[40, 612]" visible="false">
          <Skeleton id="mlSk0" translation="[0, 0]" boxWidth="272" boxHeight="340" />
          <Skeleton id="mlSk1" translation="[282, 0]" boxWidth="272" boxHeight="340" />
          <Skeleton id="mlSk2" translation="[564, 0]" boxWidth="272" boxHeight="340" />
          <Skeleton id="mlSk3" translation="[846, 0]" boxWidth="272" boxHeight="340" />
          <Skeleton id="mlSk4" translation="[1128, 0]" boxWidth="272" boxHeight="340" />
          <Skeleton id="mlSk5" translation="[1410, 0]" boxWidth="272" boxHeight="340" />
          <Skeleton id="mlSk6" translation="[1692, 0]" boxWidth="272" boxHeight="340" />
          <Skeleton id="mlSk7" translation="[1974, 0]" boxWidth="272" boxHeight="340" />
        </Group>
        <Group id="moreLikeCloseHost" translation="[1824, 516]">
          <Label id="moreLikeClose" text="✕" width="64" height="64"
            horizAlign="center" vertAlign="center" color="0xffffff99">
            <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="48" />
          </Label>
        </Group>
      </Group>
      <Animation id="moreLikeScrimIn" duration="0.3" repeat="false" easeFunction="outQuad">
        <FloatFieldInterpolator id="moreLikeScrimInterp" key="[0.0, 1.0]"
          keyValue="[0.0, 0.6]" fieldToInterp="moreLikeScrim.opacity" />
      </Animation>
      <Animation id="moreLikeDrawerIn" duration="0.3" repeat="false" easeFunction="outQuad">
        <Vector2DFieldInterpolator id="moreLikeDrawerInterp" key="[0.0, 1.0]"
          keyValue="[[0.0, 1080.0], [0.0, 0.0]]" fieldToInterp="moreLikeDrawer.translation" />
      </Animation>
    </Group>
  </children>
</component>
