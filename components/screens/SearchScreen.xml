<?xml version="1.0" encoding="utf-8" ?>
<component name="SearchScreen" extends="Group">
  <interface>
    <field id="navState" type="assocarray" onChange="OnNavStateReady" />
    <field id="keyEvent" type="assocarray" alwaysNotify="true" />
    <field id="shellEnterContent" type="boolean" value="false" alwaysNotify="true" onChange="OnShellEnterContent" />
    <field id="shellLayoutRev" type="integer" value="0" alwaysNotify="true" onChange="OnShellLayoutRev" />
    <field id="dispose" type="boolean" value="false" onChange="OnDispose" />
  </interface>

  <script type="text/brightscript" uri="pkg:/source/lib/theme/ThemeConfig.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Navigation.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/shell/AppShell.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Routes.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Registry.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Alert.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/theme/BusinessConfig.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/home/HeaderMenu.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/home/HeaderSidebarMenu.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/login/NextStep.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/login/LoginStrings.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/login/LoginService.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/net/Endpoints.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/net/Config.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/net/ApiClient.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/theme/ColorShade.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/search/SearchConstants.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/search/SearchService.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/search/SearchTheme.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/browse/BrowsePageLoader.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/grid/GridFlatFocus.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/SearchScreen.brs" />

  <children>
    <Rectangle id="bg" width="1920" height="1080" color="0x000000ff" />

    <Group id="contentHost" translation="[0, 0]">
      <Group id="layoutCol" translation="[24, 128]">
        <Group id="leftPanel" translation="[0, 0]">
          <Group id="inputWrap" translation="[-20, 0]">
            <SearchInput id="searchInput" fieldWidth="700" fieldHeight="70" />
          </Group>
          <SearchKeyboard id="keyboard" translation="[0, 102]" />
        </Group>

        <Group id="rightPanel" translation="[768, 0]">
          <Group id="gridViewport" clippingRect="[0, 0, 1152, 952]">
            <Group id="gridScrollHost" translation="[60, 0]">
              <!-- searchgrid.tsx loading: bg-black + centered primary-500 spinner in right pane only -->
              <Group id="loadingHost" visible="false">
                <Rectangle id="searchLoaderBg" width="1152" height="952" color="0x000000ff" />
                <Group id="searchLoaderCenter" translation="[576, 476]">
                  <Group id="searchLoaderSpin" rotation="0.0">
                    <Poster id="searchLoaderRing" translation="[-32, -32]" width="64" height="64"
                      uri="pkg:/images/ui/spinner_ring.png" />
                    <Poster id="searchLoaderArc" translation="[-32, -32]" width="64" height="64"
                      uri="pkg:/images/ui/spinner_arc.png" blendColor="0x0092ffff" />
                  </Group>
                  <Label id="searchLoaderText" translation="[-100, 48]" width="200" height="36"
                    horizAlign="center" vertAlign="top" text="Loading" color="0xffffffff">
                    <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="24" />
                  </Label>
                  <Animation id="searchLoaderAnim" duration="0.9" repeat="true" easeFunction="linear">
                    <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, 6.2831853]"
                      fieldToInterp="searchLoaderSpin.rotation" />
                  </Animation>
                </Group>
              </Group>
              <Group id="gridHost" />
            </Group>
          </Group>
          <Group id="emptyHost" visible="false" translation="[0, 200]">
            <Poster id="emptyIcon" uri="pkg:/images/ui/menu_search.png" width="96" height="96"
              loadDisplayMode="scaleToFit" blendColor="0xf5f5f5ff" />
            <Label id="emptyLbl" translation="[0, 120]" width="355" height="120" text="We are sorry, we can not find the content"
              wrap="true" horizAlign="center" color="0xf5f5f5ff">
              <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="30" />
            </Label>
          </Group>
        </Group>
      </Group>
    </Group>

  </children>
</component>
