<?xml version="1.0" encoding="utf-8" ?>
<!-- Profile selection — parity with src/features/profile/profile.tsx.
     React's current `true ? <NetComponent /> : ...` branch always renders circular avatars. -->
<component name="ProfileScreen" extends="Group">
  <interface>
    <field id="navState" type="assocarray" />
    <field id="keyEvent" type="assocarray" alwaysNotify="true" />
    <field id="dispose" type="boolean" value="false" onChange="OnDispose" />
  </interface>

  <script type="text/brightscript" uri="pkg:/source/lib/net/Config.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/net/Endpoints.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Registry.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Routes.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Navigation.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/login/NextStep.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/login/LoginStrings.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/login/LoginService.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/profile/ProfileStrings.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/profile/ProfileService.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/profile/ProfileUiSpec.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/profile/ProfileUiDebug.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/profile/ProfileSelectTrace.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Alert.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/net/ApiClient.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/theme/BusinessConfig.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/theme/ColorShade.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/theme/ThemeConfig.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/home/HomeConstants.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/home/HomeService.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/home/HomeBootCache.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/home/HomePerf.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/profile/ProfileTransition.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/profile/ProfileArcTheme.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/theme/SkeletonConfig.brs" />
  <script type="text/brightscript" uri="pkg:/components/cards/CardCommon.brs" />
  <script type="text/brightscript" uri="pkg:/components/profile/ProfileFetchFlow.brs" />
  <script type="text/brightscript" uri="pkg:/components/profile/ProfileAppearance.brs" />
  <script type="text/brightscript" uri="pkg:/components/profile/ProfileFocus.brs" />
  <script type="text/brightscript" uri="pkg:/components/profile/ProfileSelectFlow.brs" />
  <script type="text/brightscript" uri="pkg:/components/profile/ProfileAutoSelect.brs" />
  <script type="text/brightscript" uri="pkg:/components/profile/ProfileListScroll.brs" />
  <script type="text/brightscript" uri="pkg:/components/profile/ProfileOverlays.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/ProfileScreen.brs" />

  <children>
    <Rectangle id="bg" width="1920" height="1080" />
    <Poster id="bgImage" width="1920" height="1080" loadDisplayMode="scaleToFill" opacity="1.0" />
    <!-- profile.tsx always-on: smooth bottom vignette (no hard horizontal band). -->
    <Poster id="bgBottomVignette" width="1920" height="1080"
      uri="pkg:/images/ui/profile_bg_bottom_vignette.png" loadDisplayMode="scaleToFill" opacity="1.0" />
    <!-- profile.tsx focusedProfile: left-to-right scrim over poster bg only. -->
    <Poster id="bgFocusScrim" width="1920" height="1080"
      uri="pkg:/images/ui/profile_focus_bg_gradient.png" loadDisplayMode="scaleToFill" opacity="0.0" />

    <!-- Profile list layer (behind header chrome — scroll must never paint over the title). -->
    <Group id="skeletonGroup" translation="[64, 265]" visible="false">
      <ProfileSkeletonBox id="sk0a" translation="[0, 0]" boxWidth="150" boxHeight="150" glowKind="avatar" />
      <ProfileSkeletonBox id="sk0b" translation="[230, 72]" boxWidth="190" boxHeight="22" glowKind="pill" />
      <ProfileSkeletonBox id="sk1a" translation="[0, 210]" boxWidth="150" boxHeight="150" glowKind="avatar" />
      <ProfileSkeletonBox id="sk1b" translation="[230, 282]" boxWidth="190" boxHeight="22" glowKind="pill" />
      <ProfileSkeletonBox id="sk2a" translation="[0, 420]" boxWidth="150" boxHeight="150" glowKind="avatar" />
      <ProfileSkeletonBox id="sk2b" translation="[230, 492]" boxWidth="190" boxHeight="22" glowKind="pill" />
    </Group>

    <Group id="profilesScrollHost" translation="[64, 0]">
      <MaskGroup id="profilesViewport" maskUri="pkg:/images/ui/profile_list_viewport_mask.png"
        maskSize="[1760, 689]" maskOffset="[0, 265]">
        <Group id="profilesContainer" />
      </MaskGroup>
    </Group>

    <!-- Transparent header chrome — higher z-order; cards scroll underneath. -->
    <Group id="profileHeaderChrome" translation="[0, 0]">
      <Rectangle id="headerTextBackdrop" translation="[48, 36]" width="928" height="180"
        opacity="0.30" />
      <Poster id="logoPoster" translation="[120, 48]" width="280" height="68" loadDisplayMode="scaleToFit" visible="false" />
      <Label id="logoLabel" text="OTT Accelerator" translation="[120, 64]" width="400"
        visible="false">
        <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="30" />
      </Label>
      <Label id="title" text="Who's Watching?" translation="[64, 152]" width="900">
        <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="41" />
      </Label>
      <Label id="errorLabel" text="" translation="[64, 214]" width="900" visible="false">
        <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="20" />
      </Label>
    </Group>

    <LoginTabButton id="logoutBtn" label="Logout" translation="[1656, 970]"
      buttonWidth="200" buttonHeight="65"
      shapeUri="pkg:/images/ui/btn_logout.png" shadowUri="pkg:/images/ui/btn_logout_shadow.png"
      fontUri="pkg:/fonts/Inter-Bold.ttf" fontSize="20" visible="false" />

    <ConfirmPopup id="confirmPopup" visible="false" />
    <OtpPopup id="otpPopup" visible="false" />
    <EditProfilePopup id="editProfilePopup" visible="false" />

    <ProfileSelectingOverlay id="selectingOverlay" visible="false" />

    <Timer id="autoSelectTimer" duration="0.1" repeat="true" />
  </children>
</component>
