<?xml version="1.0" encoding="utf-8" ?>
<!-- Rounded pill button (login tabs + Login). Rounded shape from an exact-size
     white PNG tinted via blendColor. Soft drop shadow (shadow-primary-700) shows
     when selected/focused. DM Sans SemiBold to match the web (font-inter/DM Sans). -->
<component name="LoginTabButton" extends="Group">
  <interface>
    <field id="label" type="string" onChange="OnLabelChanged" />
    <field id="bgColor" type="string" value="0x0760bbff" onChange="ApplyStyle" />
    <field id="textColor" type="string" value="0xf8f1f7ff" onChange="ApplyStyle" />
    <field id="buttonWidth" type="integer" value="232" onChange="OnSizeChanged" />
    <field id="buttonHeight" type="integer" value="56" onChange="OnSizeChanged" />
    <field id="shapeUri" type="string" value="pkg:/images/ui/tab_phone.png" onChange="OnShapeChanged" />
    <field id="shadowUri" type="string" value="" onChange="OnShapeChanged" />
    <field id="shadowColor" type="string" value="0x04478bff" onChange="ApplyStyle" />
    <field id="showShadow" type="boolean" value="false" onChange="ApplyStyle" />
    <field id="fontUri" type="string" value="pkg:/fonts/Inter-SemiBold.ttf" onChange="OnFontChanged" />
    <field id="fontSize" type="integer" value="20" onChange="OnFontChanged" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/widgets/LoginTabButton.brs" />
  <children>
    <Poster id="shadow" width="328" height="152" uri="" blendColor="0x04478bff" opacity="0.7" visible="false" />
    <Poster id="bg" width="232" height="56" uri="pkg:/images/ui/tab_phone.png" blendColor="0x0760bbff" />
    <Label id="text" translation="[0, 0]" text="" width="232" height="56"
      horizAlign="center" vertAlign="center" color="0xf8f1f7ff">
      <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="20" />
    </Label>
  </children>
</component>
