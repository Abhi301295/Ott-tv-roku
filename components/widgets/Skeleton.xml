<?xml version="1.0" encoding="utf-8" ?>
<!-- Shimmer skeleton (parity with react-loading-skeleton SkeletonBox).
     Rounded base + a soft, feathered highlight band that sweeps left→right, looping. -->
<component name="Skeleton" extends="Group">
  <interface>
    <field id="boxWidth" type="float" value="150" onChange="OnSizeChanged" />
    <field id="boxHeight" type="float" value="150" onChange="OnSizeChanged" />
    <field id="baseColor" type="string" value="0xffffffff" onChange="OnColorsChanged" />
    <field id="highlightColor" type="string" value="0xf3f3f3ff" onChange="OnColorsChanged" />
    <field id="running" type="boolean" value="false" onChange="OnRunningChanged" />
    <field id="animate" type="boolean" value="true" onChange="OnRunningChanged" />
    <!-- Colors: set in source/lib/theme/SkeletonConfig.brs (login excluded). -->
    <!-- Swap the placeholder shape (e.g. a circle for radius-full dots). -->
    <field id="shapeUri" type="string" value="pkg:/images/ui/sk_base.png" onChange="OnShapeChanged" />
  </interface>

  <script type="text/brightscript" uri="pkg:/components/widgets/Skeleton.brs" />

  <children>
    <!-- Rounded neutral-700 base with a lighter highlight overlay that pulses opacity. -->
    <Poster id="base" width="150" height="150" uri="pkg:/images/ui/sk_base.png"
      loadDisplayMode="scaleToFill" blendColor="0xffffffff" />
    <Poster id="shine" width="150" height="150" uri="pkg:/images/ui/sk_base.png"
      loadDisplayMode="scaleToFill" blendColor="0xf3f3f3ff" opacity="0.0" />
    <!-- Opaque base + highlight overlay pulse (base opacity never drops — shimmer must not go transparent). -->
    <Animation id="anim" duration="1.1" repeat="true" easeFunction="inOutQuad">
      <FloatFieldInterpolator id="interp" key="[0.0,0.5,1.0]"
        keyValue="[0.0,0.85,0.0]" fieldToInterp="shine.opacity" />
    </Animation>
  </children>
</component>
