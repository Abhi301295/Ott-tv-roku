<?xml version="1.0" encoding="utf-8" ?>
<!-- Shimmer skeleton (parity with react-loading-skeleton SkeletonBox).
     Default: sharp Rectangle blocks (any aspect ratio). Set shapeUri to a same-size PNG
     mask when the React source uses border-radius (e.g. sk_detail_title.png 400×80). -->
<component name="Skeleton" extends="Group">
  <interface>
    <field id="boxWidth" type="float" value="150" onChange="OnSizeChanged" />
    <field id="boxHeight" type="float" value="150" onChange="OnSizeChanged" />
    <field id="baseColor" type="string" value="0xffffffff" onChange="OnColorsChanged" />
    <field id="highlightColor" type="string" value="0xf3f3f3ff" onChange="OnColorsChanged" />
    <field id="running" type="boolean" value="false" onChange="OnRunningChanged" />
    <field id="animate" type="boolean" value="true" onChange="OnRunningChanged" />
    <!-- Colors: set in source/lib/theme/SkeletonConfig.brs (login excluded). -->
    <!-- Same-size PNG mask for rounded shapes; empty = square Rectangle. -->
    <field id="shapeUri" type="string" value="" onChange="OnShapeChanged" />
  </interface>

  <script type="text/brightscript" uri="pkg:/components/widgets/Skeleton.brs" />

  <children>
    <Rectangle id="baseRect" width="150" height="150" color="0xffffffff" />
    <Rectangle id="shineRect" width="150" height="150" color="0xf3f3f3ff" opacity="0.0" />
    <Poster id="basePoster" width="150" height="150" uri="" visible="false"
      loadDisplayMode="scaleToFit" blendColor="0xffffffff" />
    <Poster id="shinePoster" width="150" height="150" uri="" visible="false"
      loadDisplayMode="scaleToFit" blendColor="0xf3f3f3ff" opacity="0.0" />
    <!-- Opaque base + highlight overlay pulse (base opacity never drops — shimmer must not go transparent). -->
    <Animation id="anim" duration="1.1" repeat="true" easeFunction="inOutQuad">
      <FloatFieldInterpolator id="interpRect" key="[0.0,0.5,1.0]"
        keyValue="[0.0,0.85,0.0]" fieldToInterp="shineRect.opacity" />
      <FloatFieldInterpolator id="interpPoster" key="[0.0,0.5,1.0]"
        keyValue="[0.0,0.85,0.0]" fieldToInterp="shinePoster.opacity" />
    </Animation>
  </children>
</component>
