<?xml version="1.0" encoding="utf-8" ?>
<!-- Search input — parity searchbar.tsx: bg-neutral-700, rounded-xl, primary-500 ring on focus. -->
<component name="SearchInput" extends="Group">
  <interface>
    <field id="value" type="string" value="" onChange="OnValueChanged" />
    <field id="placeholder" type="string" value="Search Raven, She..." onChange="OnValueChanged" />
    <field id="fieldWidth" type="integer" value="700" onChange="OnSizeChanged" />
    <field id="fieldHeight" type="integer" value="70" onChange="OnSizeChanged" />
    <field id="bgColor" type="string" value="0x181818ff" onChange="ApplyStyle" />
    <field id="borderColor" type="string" value="0x0092ffff" onChange="ApplyStyle" />
    <field id="textColor" type="string" value="0xffffffff" onChange="ApplyStyle" />
    <field id="placeholderColor" type="string" value="0x6b7280ff" onChange="ApplyStyle" />
    <field id="focusedState" type="boolean" value="false" onChange="ApplyStyle" />
  </interface>

  <script type="text/brightscript" uri="pkg:/source/lib/search/SearchConstants.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/SearchInput.brs" />

  <children>
    <Poster id="border" width="700" height="70" uri="pkg:/images/ui/field_border.png" blendColor="0x0092ffff" visible="false" />
    <Poster id="bg" translation="[2, 2]" width="696" height="66" uri="pkg:/images/ui/field_bg.png" blendColor="0x181818ff" />
    <Label id="text" translation="[16, 0]" width="660" height="70" text="" horizAlign="left" vertAlign="center" color="0xffffffff">
      <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="34" />
    </Label>
  </children>
</component>
