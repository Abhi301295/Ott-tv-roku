<?xml version="1.0" encoding="utf-8" ?>
<!-- OTT focus-reactive hero — parity with src/components/banner/index.tsx. -->
<component name="HeroBannerOtt" extends="Group">
  <interface>
    <field id="activeItem" type="assocarray" onChange="OnActiveItemChanged" />
    <field id="bannerItems" type="array" onChange="OnBannerItemsChanged" />
    <field id="posterReady" type="boolean" value="false" alwaysNotify="true" />
    <field id="trailerPlaying" type="boolean" value="false" />
    <field id="cNeutral50" type="string" value="0xf8f1f7ff" onChange="OnThemeChanged" />
    <field id="cPrimary500" type="string" value="0x0b75e0ff" onChange="OnThemeChanged" />
    <field id="focusTarget" type="string" value="" />
    <function name="HeroGoNext" />
    <function name="HeroGoPrev" />
    <function name="HeroToggleMute" />
  </interface>

  <script type="text/brightscript" uri="pkg:/source/lib/home/HomeConstants.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/home/CardHelper.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/home/HeroBannerCommon.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/HeroBannerOtt.brs" />

  <children>
    <Rectangle id="heroBg" width="1920" height="1080" color="0x0a0a0aff" />
    <Group id="imageHost" clippingRect="[0, 0, 1920, 1080]" clippingRectClipsChildren="true">
      <Rectangle id="imageFallback" width="1920" height="1080" color="0x171717ff" />
      <Poster id="bannerPoster" width="1920" height="1080" loadDisplayMode="scaleToFill"
        opacity="0.0" />
    </Group>
    <Poster id="gradLeft" uri="pkg:/images/ui/grad_left.png" width="768" height="1080"
      loadDisplayMode="scaleToFill" />
    <Poster id="gradTop" uri="pkg:/images/ui/grad_top.png" width="1920" height="160"
      loadDisplayMode="scaleToFill" />
    <Poster id="gradBottom" uri="pkg:/images/ui/grad_bottom.png" translation="[0, 700]"
      width="1920" height="380" loadDisplayMode="scaleToFill" />

    <Group id="metaHost" translation="[48, 200]">
      <Label id="titleLabel" text="" width="1100" height="100" wrap="false"
        color="0xf8f1f7ff" horizAlign="left" vertAlign="top">
        <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="60" />
      </Label>
      <LayoutGroup id="ratingHost" translation="[0, 108]" layoutDirection="horiz"
        itemSpacings="[8]" vertAlignment="center" visible="false">
        <Label id="ratingLabel" text="" height="36" color="0xf8f1f7ff"
          horizAlign="left" vertAlign="center">
          <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="20" />
        </Label>
      </LayoutGroup>
      <Label id="descLabel" translation="[0, 152]" text="" width="900" height="140"
        wrap="true" color="0xffffffe6" horizAlign="left" vertAlign="top">
        <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="22" />
      </Label>
      <LayoutGroup id="genreHost" translation="[0, 300]" layoutDirection="horiz"
        itemSpacings="[12]" vertAlignment="center">
        <Label id="genreLabel" text="" height="32" color="0xf8f1f7ff"
          horizAlign="left" vertAlign="center">
          <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="20" />
        </Label>
        <Group id="qualityBadge" visible="false">
          <Rectangle id="qualityBg" width="72" height="30" color="0xffffff33" />
          <Label id="qualityLabel" text="" width="72" height="30"
            color="0xf8f1f7ff" horizAlign="center" vertAlign="center">
            <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="14" />
          </Label>
        </Group>
        <Group id="maturityBadge" visible="false">
          <Rectangle id="maturityBg" width="48" height="26" color="0x00000033" />
          <Poster id="maturityBorder" width="48" height="26"
            uri="pkg:/images/ui/field_bg.png" opacity="0.4" loadDisplayMode="scaleToFill" />
          <Label id="maturityLabel" text="" width="48" height="26"
            color="0xf8f1f7ff" horizAlign="center" vertAlign="center">
            <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="12" />
          </Label>
        </Group>
      </LayoutGroup>
    </Group>

    <Animation id="fadeAnim" duration="0.7" repeat="false" easeFunction="inOutCubic">
      <FloatFieldInterpolator id="fadeInterp" key="[0.0, 1.0]"
        fieldToInterp="bannerPoster.opacity" />
    </Animation>
    <Animation id="scaleAnim" duration="0.7" repeat="false" easeFunction="inOutCubic">
      <Vector2DFieldInterpolator id="scaleInterp" key="[0.0, 1.0]"
        fieldToInterp="bannerPoster.scale" />
    </Animation>
  </children>
</component>
