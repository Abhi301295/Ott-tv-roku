<?xml version="1.0" encoding="utf-8" ?>
<!-- Cinematic profile → Home transition (parity with React netComponent setup state). -->
<component name="ProfileSelectingOverlay" extends="Group">
  <interface>
    <field id="profileName" type="string" value="" onChange="OnProfileChanged" />
    <field id="avatarUri" type="string" value="" onChange="OnProfileChanged" />
    <field id="initials" type="string" value="" onChange="OnProfileChanged" />
    <field id="primaryColor" type="string" value="0x0b75e0ff" onChange="OnColorsChanged" />
    <field id="neutral50" type="string" value="0xf8f1f7ff" onChange="OnColorsChanged" />
    <field id="avatarBg" type="string" value="0x404040ff" onChange="OnColorsChanged" />
    <field id="running" type="boolean" value="false" onChange="OnRunningChanged" />
    <!-- Set during prefetch; label queues to next arc tick (never blocks spinner). -->
    <field id="statusText" type="string" value="" onChange="OnStatusTextChanged" />
    <function name="ClearStatusLabelFunc" />
  </interface>

  <script type="text/brightscript" uri="pkg:/source/lib/profile/ProfileStrings.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/profile/ProfileUiSpec.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/ProfileSelectingOverlay.brs" />

  <children>
    <Rectangle id="scrim" width="1920" height="1080" color="0x08080af2" />
    <Poster id="vignette" width="1920" height="1080" uri="pkg:/images/ui/profile_bg_overlay.png"
      opacity="0.55" blendColor="0x000000ff" />

    <Group id="contentHost" translation="[960, 470]" opacity="0.0">
      <Group id="avatarStack" translation="[-110, -118]">
        <Poster id="progressTrack" width="220" height="220" uri="pkg:/images/ui/avatar_ring.png"
          blendColor="0xffffffff" opacity="0.28" />
        <Poster id="progressArc" width="220" height="220" uri="pkg:/images/ui/profile_arc_000.png" />
        <MaskGroup id="avatarMask" maskUri="pkg:/images/ui/avatar_circle.png"
          maskSize="[192, 192]" maskOffset="[14, 14]">
          <Poster id="circleBg" translation="[14, 14]" width="192" height="192"
            uri="pkg:/images/ui/avatar_circle.png" blendColor="0x404040ff" />
          <Poster id="avatarImg" translation="[14, 14]" width="192" height="192"
            loadDisplayMode="scaleToFill" visible="false" />
          <Label id="initialsLbl" translation="[14, 14]" width="192" height="192"
            horizAlign="center" vertAlign="center" color="0xf8f1f7ff">
            <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="58" />
          </Label>
        </MaskGroup>
      </Group>

      <Label id="welcomeLbl" translation="[-460, 132]" width="920" height="52"
        horizAlign="center" vertAlign="top" color="0xf8f1f7ff" wrap="false">
        <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="38" />
      </Label>
      <Label id="statusLbl" translation="[-460, 194]" width="920" height="34"
        horizAlign="center" vertAlign="top" color="0x9ea4b0ff" wrap="false">
        <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="22" />
      </Label>
    </Group>

    <Animation id="fadeIn" duration="0.42" repeat="false" easeFunction="outCubic">
      <FloatFieldInterpolator id="fadeInterp" key="[0.0, 1.0]" keyValue="[0.0, 1.0]"
        fieldToInterp="contentHost.opacity" />
    </Animation>

    <Timer id="arcTimer" duration="0.045" repeat="true" />
    <Timer id="statusTimer" duration="2.0" repeat="true" />
  </children>
</component>
