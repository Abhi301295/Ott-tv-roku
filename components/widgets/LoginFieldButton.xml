<?xml version="1.0" encoding="utf-8" ?>
<!-- Rounded input (email/password). Rounded shape from exact-size white PNGs
     tinted via blendColor; focus shows the border ring. -->
<component name="LoginFieldButton" extends="Group">
  <interface>
    <field id="label" type="string" onChange="OnLabelChanged" />
    <field id="value" type="string" value="" onChange="OnValueChanged" />
    <field id="fieldWidth" type="integer" value="842" onChange="OnSizeChanged" />
    <field id="fieldHeight" type="integer" value="56" onChange="OnSizeChanged" />
    <field id="secure" type="boolean" value="false" />
    <field id="bgColor" type="string" value="0xffffffff" onChange="ApplyStyle" />
    <field id="bgColorFocused" type="string" value="0xffffffff" onChange="ApplyStyle" />
    <field id="textColor" type="string" value="0xf8f1f7ff" onChange="ApplyStyle" />
    <field id="placeholderColor" type="string" value="0xf8f1f7ff" onChange="ApplyStyle" />
    <field id="placeholderColorFocused" type="string" value="0x9ea4b0ff" onChange="ApplyStyle" />
    <field id="borderColor" type="string" value="0xefdcebff" onChange="ApplyStyle" />
    <field id="focusedState" type="boolean" value="false" onChange="ApplyStyle" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/widgets/LoginFieldButton.brs" />
  <children>
    <Poster id="border" width="842" height="56" uri="pkg:/images/ui/field_border.png" blendColor="0xefdcebff" visible="false" />
    <Poster id="bg" translation="[2, 2]" width="838" height="52" uri="pkg:/images/ui/field_bg.png" blendColor="0xffffffff" />
    <Label id="text" text="" translation="[24, 0]" width="794" height="56"
      vertAlign="center" color="0xf8f1f7ff">
      <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="20" />
    </Label>
  </children>
</component>
