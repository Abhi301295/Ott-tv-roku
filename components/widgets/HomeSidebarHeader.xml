<?xml version="1.0" encoding="utf-8" ?>
<!-- Sidebar header — parity with header.tsx SIDEBAR branch + HeaderMenuItem. -->
<component name="HomeSidebarHeader" extends="Group">
  <interface>
    <field id="menuItems" type="array" onChange="OnMenuChanged" />
    <field id="focusedIndex" type="integer" value="0" onChange="OnFocusChanged" />
    <field id="selectedIndex" type="integer" value="0" onChange="OnFocusChanged" />
    <field id="headerActive" type="boolean" value="false" onChange="OnLayoutChanged" />
    <field id="instantLayout" type="boolean" value="false" />
    <field id="logoUri" type="string" value="" onChange="OnLogoChanged" />
    <field id="logoCroppedUri" type="string" value="" onChange="OnLogoChanged" />
    <field id="appName" type="string" value="" onChange="OnLogoChanged" />
    <field id="avatarUri" type="string" value="" onChange="OnAvatarChanged" />
    <field id="cPrimary500" type="string" value="0x0b75e0ff" onChange="OnThemeChanged" />
    <field id="cPrimary700" type="string" value="0x80bbe9ff" onChange="OnThemeChanged" />
    <field id="cNeutral50" type="string" value="0xf8f1f7ff" onChange="OnThemeChanged" />
    <field id="cNeutral100" type="string" value="0xf8f8f8ff" onChange="OnThemeChanged" />
    <field id="cNeutral200" type="string" value="0xd4d4d4ff" onChange="OnThemeChanged" />
    <field id="cNeutral700" type="string" value="0x181818ff" onChange="OnThemeChanged" />
    <field id="cNeutral800" type="string" value="0x262626ff" onChange="OnThemeChanged" />
    <field id="cNeutral950" type="string" value="0x0a0a0aff" onChange="OnThemeChanged" />
    <field id="scrimOpacity" type="float" value="0.0" />
    <field id="sidebarWidth" type="integer" value="100" alwaysNotify="true" />
  </interface>

  <script type="text/brightscript" uri="pkg:/source/lib/theme/ThemeConfig.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/HomeSidebarHeader.brs" />

  <children>
    <Rectangle id="bg" width="100" height="1080" color="0x121212ff" />
    <Poster id="logoPoster" translation="[10, 100]" width="80" height="80"
      loadDisplayMode="scaleToFit" visible="false" />
    <Label id="logoLabel" translation="[8, 100]" width="84" height="80" wrap="true"
      color="0xf8f1f7ff" horizAlign="center" vertAlign="top" visible="false">
      <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="16" />
    </Label>
    <Group id="menuCol" translation="[0, 220]" />

    <Animation id="widthAnim" duration="0.3" repeat="false" easeFunction="inOutCubic">
      <FloatFieldInterpolator id="widthInterp" key="[0.0, 1.0]"
        fieldToInterp="bg.width" />
    </Animation>
    <Animation id="avatarAnim" duration="0.3" repeat="false" easeFunction="inOutCubic">
      <Vector2DFieldInterpolator id="avatarInterp" key="[0.0, 1.0]"
        fieldToInterp="avatarMask.translation" />
    </Animation>

    <MaskGroup id="avatarMask" translation="[18, 980]"
      maskUri="pkg:/images/ui/avatar_circle.png" maskSize="[64, 64]">
      <Poster id="avatarBg" width="64" height="64"
        uri="pkg:/images/ui/avatar_circle.png" blendColor="0x404040ff" />
      <Poster id="avatarImg" width="64" height="64"
        loadDisplayMode="scaleToFill" visible="false" />
    </MaskGroup>
  </children>
</component>
