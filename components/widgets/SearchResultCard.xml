<?xml version="1.0" encoding="utf-8" ?>
<!-- Search result tile — parity search-horizontalcard.tsx 280×150 rounded-xl. -->
<component name="SearchResultCard" extends="Group">
  <interface>
    <field id="title" type="string" value="" onChange="OnDataChanged" />
    <field id="thumbnailUri" type="string" value="" onChange="OnDataChanged" />
    <field id="focusedState" type="boolean" value="false" onChange="OnFocusChanged" />
    <field id="cPageBg" type="string" value="0x1f1f22ff" onChange="OnThemeChanged" />
    <field id="cPrimary700" type="string" value="0x80bbe9ff" onChange="OnThemeChanged" />
    <field id="cNeutral50" type="string" value="0xffffffff" onChange="OnThemeChanged" />
    <field id="cNeutral700" type="string" value="0x181818ff" onChange="OnThemeChanged" />
  </interface>

  <script type="text/brightscript" uri="pkg:/source/lib/search/SearchConstants.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/theme/SkeletonConfig.brs" />
  <script type="text/brightscript" uri="pkg:/components/cards/CardCommon.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/SearchResultCard.brs" />

  <children>
    <Group id="thumbBlock" translation="[0, 10]">
      <Animation id="scaleAnim" duration="0.3" repeat="false" easeFunction="outQuad">
        <Vector2DFieldInterpolator id="scaleInterp" key="[0.0, 1.0]"
          keyValue="[[1.0, 1.0], [1.0, 1.0]]" fieldToInterp="thumbWrap.scale" />
      </Animation>
      <Group id="thumbWrap" translation="[0, 0]">
        <!-- MaskGroup does not clip in brs-engine/sim — corner nubs + page-bg tint (see ContinueWatchCard). -->
        <Poster id="thumb" width="280" height="150" loadDisplayMode="scaleToZoom" visible="false" />
        <Poster id="grad" width="280" height="150" uri="pkg:/images/ui/grad_bottom.png" opacity="0.35" blendColor="0x505050ff" />
        <Poster id="cornerTL" uri="pkg:/images/ui/search_card_corner_tl.png" width="12" height="12" translation="[0, 0]" loadDisplayMode="scaleToFill" />
        <Poster id="cornerTR" uri="pkg:/images/ui/search_card_corner_tr.png" width="12" height="12" translation="[268, 0]" loadDisplayMode="scaleToFill" />
        <Poster id="cornerBL" uri="pkg:/images/ui/search_card_corner_bl.png" width="12" height="12" translation="[0, 138]" loadDisplayMode="scaleToFill" />
        <Poster id="cornerBR" uri="pkg:/images/ui/search_card_corner_br.png" width="12" height="12" translation="[268, 138]" loadDisplayMode="scaleToFill" />
        <Poster id="focusRing" width="280" height="150" uri="pkg:/images/ui/search_card_focus_ring.png"
          loadDisplayMode="scaleToFill" visible="false" />
      </Group>
    </Group>
    <Label id="titleLbl" translation="[0, 170]" width="230" height="28" wrap="false" ellipsizeOnBoundary="true" horizAlign="left" color="0xffffffff">
      <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="24" />
    </Label>
  </children>
</component>
