<?xml version="1.0" encoding="utf-8" ?>
<!-- Switches hero widgets by ThemeConfig (homeLayout + heroBannerStyle). -->
<component name="HeroBannerHost" extends="Group">
  <interface>
    <field id="bannerItems" type="array" onChange="OnBannerItemsChanged" />
    <field id="activeItem" type="assocarray" onChange="OnActiveItemChanged" />
    <field id="posterReady" type="boolean" value="false" alwaysNotify="true" />
    <field id="trailerPlaying" type="boolean" value="false" alwaysNotify="true" />
    <field id="cNeutral50" type="string" value="0xf8f1f7ff" onChange="OnThemeChanged" />
    <field id="cPrimary500" type="string" value="0x0b75e0ff" onChange="OnThemeChanged" />
    <field id="focusTarget" type="string" value="" onChange="OnFocusTargetChanged" />
    <!-- Usable width after the left sidebar inset (1920 − offset). Keeps hero controls in view. -->
    <field id="contentWidth" type="integer" value="1920" onChange="OnContentWidthChanged" />
    <!-- Tracks input-priority pause; Resume/Pause are driven explicitly from HomeScreen. -->
    <field id="autoAdvanceHold" type="boolean" value="false" onChange="OnAutoAdvanceHoldChanged" />
    <!-- While true, cinematic hero defers trailer resolve/playback until rows are visible. -->
    <field id="holdTrailerBoot" type="boolean" value="false" onChange="OnHoldTrailerBootChanged" />
    <function name="HeroGoNext" />
    <function name="HeroGoPrev" />
    <function name="HeroToggleMute" />
    <function name="PauseAutoAdvance" />
    <function name="ResumeAutoAdvance" />
    <function name="PauseHeroPlayback" />
    <function name="ResumeHeroPlayback" />
  </interface>

  <script type="text/brightscript" uri="pkg:/source/lib/theme/ThemeConfig.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/HeroBannerHost.brs" />

  <children>
    <HeroBannerCinematic id="heroCinematic" visible="false" />
    <HeroBannerPageFlip id="heroPageFlip" visible="false" />
    <HeroBannerParallax id="heroParallax" visible="false" />
    <HeroBannerOtt id="heroOtt" visible="false" />
  </children>
</component>
