<?xml version="1.0" encoding="utf-8" ?>
<!-- Home loading scaffold — opaque base + highlight overlay pulse (base opacity never drops). -->
<component name="HomeSkeleton" extends="Group">
  <interface>
    <field id="boxColor" type="string" value="0x404040ff" onChange="OnColorsChanged" />
    <field id="shineColor" type="string" value="0x525252ff" onChange="OnColorsChanged" />
    <field id="backdropColor" type="string" value="0xe5e5e5ff" onChange="OnColorsChanged" />
    <field id="heroRunning" type="boolean" value="false" onChange="OnRunningChanged" />
    <field id="rowsRunning" type="boolean" value="false" onChange="OnRunningChanged" />
    <field id="layoutMode" type="string" value="netflix" onChange="OnLayoutChanged" />
    <field id="anchorY" type="integer" value="702" onChange="OnLayoutChanged" />
  </interface>

  <script type="text/brightscript" uri="pkg:/source/lib/home/HomeConstants.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/home/CardHelper.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/theme/SkeletonConfig.brs" />
  <script type="text/brightscript" uri="pkg:/components/cards/CardCommon.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/HomeSkeleton.brs" />

  <children>
    <Group id="heroPulse" opacity="1.0" visible="false">
      <Rectangle id="heroBackdrop" translation="[0, 0]" width="1920" height="918" color="0xe5e5e5ff" />
      <Rectangle id="heroBackdropShine" translation="[0, 0]" width="1920" height="918"
        color="0xf0f0f0ff" opacity="0.0" />
      <Rectangle id="hTitle" translation="[64, 300]" width="520" height="54" color="0x404040ff" />
      <Rectangle id="hTitleShine" translation="[64, 300]" width="520" height="54" color="0x525252ff" opacity="0.0" />
      <Rectangle id="hGenre" translation="[64, 444]" width="360" height="22" color="0x404040ff" />
      <Rectangle id="hGenreShine" translation="[64, 444]" width="360" height="22" color="0x525252ff" opacity="0.0" />
      <Rectangle id="hDesc1" translation="[64, 490]" width="630" height="18" color="0x404040ff" />
      <Rectangle id="hDesc1Shine" translation="[64, 490]" width="630" height="18" color="0x525252ff" opacity="0.0" />
      <Rectangle id="hDesc2" translation="[64, 518]" width="580" height="18" color="0x404040ff" />
      <Rectangle id="hDesc2Shine" translation="[64, 518]" width="580" height="18" color="0x525252ff" opacity="0.0" />
    </Group>

    <Label id="rowsTitle" text="Continue Watching" translation="[32, 702]" width="600" height="40"
      color="0xf8f1f7ff" visible="false">
      <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="34" />
    </Label>

    <Group id="rowsPulse" opacity="1.0" visible="false">
      <Rectangle id="rowBox1" translation="[32, 757]"   width="540" height="286" color="0x404040ff" />
      <Rectangle id="rowShine1" translation="[32, 757]"   width="540" height="286" color="0x525252ff" opacity="0.0" />
      <Rectangle id="rowBox2" translation="[582, 757]"  width="540" height="286" color="0x404040ff" />
      <Rectangle id="rowShine2" translation="[582, 757]"  width="540" height="286" color="0x525252ff" opacity="0.0" />
      <Rectangle id="rowBox3" translation="[1132, 757]" width="540" height="286" color="0x404040ff" />
      <Rectangle id="rowShine3" translation="[1132, 757]" width="540" height="286" color="0x525252ff" opacity="0.0" />
      <Rectangle id="rowBox4" translation="[1682, 757]" width="540" height="286" color="0x404040ff" />
      <Rectangle id="rowShine4" translation="[1682, 757]" width="540" height="286" color="0x525252ff" opacity="0.0" />
    </Group>

    <!-- Pulse highlight overlays only — base rects stay opacity 1.0 (never transparent). -->
    <Animation id="heroAnim" duration="1.1" repeat="true" easeFunction="inOutQuad">
      <FloatFieldInterpolator id="heroBackdropInterp" key="[0.0, 0.5, 1.0]" keyValue="[0.0, 0.75, 0.0]" fieldToInterp="heroBackdropShine.opacity" />
      <FloatFieldInterpolator id="heroInterp1" key="[0.0, 0.5, 1.0]" keyValue="[0.0, 0.85, 0.0]" fieldToInterp="hTitleShine.opacity" />
      <FloatFieldInterpolator id="heroInterp2" key="[0.0, 0.5, 1.0]" keyValue="[0.0, 0.85, 0.0]" fieldToInterp="hGenreShine.opacity" />
      <FloatFieldInterpolator id="heroInterp3" key="[0.0, 0.5, 1.0]" keyValue="[0.0, 0.85, 0.0]" fieldToInterp="hDesc1Shine.opacity" />
      <FloatFieldInterpolator id="heroInterp4" key="[0.0, 0.5, 1.0]" keyValue="[0.0, 0.85, 0.0]" fieldToInterp="hDesc2Shine.opacity" />
    </Animation>
    <Animation id="rowsAnim" duration="1.1" repeat="true" easeFunction="inOutQuad">
      <FloatFieldInterpolator id="rowsInterp1" key="[0.0, 0.5, 1.0]" keyValue="[0.0, 0.85, 0.0]" fieldToInterp="rowShine1.opacity" />
      <FloatFieldInterpolator id="rowsInterp2" key="[0.0, 0.5, 1.0]" keyValue="[0.0, 0.85, 0.0]" fieldToInterp="rowShine2.opacity" />
      <FloatFieldInterpolator id="rowsInterp3" key="[0.0, 0.5, 1.0]" keyValue="[0.0, 0.85, 0.0]" fieldToInterp="rowShine3.opacity" />
      <FloatFieldInterpolator id="rowsInterp4" key="[0.0, 0.5, 1.0]" keyValue="[0.0, 0.85, 0.0]" fieldToInterp="rowShine4.opacity" />
    </Animation>
  </children>
</component>
