    <Label id="upNextTitle" translation="[14, 188]" text="" width="135" height="22"
      wrap="true" color="0xf8f1f7cc" horizAlign="left" vertAlign="bottom">
      <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="16" />
    </Label>
  </children>
</component>
