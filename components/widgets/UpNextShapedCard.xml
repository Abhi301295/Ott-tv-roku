<?xml version="1.0" encoding="utf-8" ?>
<!-- Up Next cutout — heroBanner.tsx parity via MaskGroup (OpenGL device path). -->
<component name="UpNextShapedCard" extends="Group">
  <interface>
    <field id="posterUri" type="string" value="" onChange="OnPosterUriChanged" />
    <field id="heroUri" type="string" value="" onChange="OnHeroUriChanged" />
    <field id="titleText" type="string" value="" onChange="OnTitleChanged" />
    <field id="focused" type="boolean" value="false" onChange="OnFocusedChanged" />
    <field id="cNeutral50" type="string" value="0xf8f1f7ff" onChange="OnFocusedChanged" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/lib/home/UpNextLayout.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/UpNextShapedCard.brs" />
