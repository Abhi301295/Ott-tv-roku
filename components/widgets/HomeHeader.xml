<?xml version="1.0" encoding="utf-8" ?>
<!-- Netflix top bar — parity with ottHeader.tsx NetflixHeader: cropped logo left,
     centered text menu, profile avatar right. Focus/selection render as a text
     brightness change plus a bottom border (neutral-50 focused, primary-500 active
     route). The owning screen drives focusedIndex / selectedIndex / headerActive. -->
<component name="HomeHeader" extends="Group">
  <interface>
    <field id="menuTexts" type="array" onChange="OnMenuChanged" />
    <field id="focusedIndex" type="integer" value="0" onChange="OnFocusChanged" />
    <field id="selectedIndex" type="integer" value="0" onChange="OnFocusChanged" />
    <field id="headerActive" type="boolean" value="false" onChange="OnFocusChanged" />
    <field id="logoUri" type="string" value="" onChange="OnLogoChanged" />
    <field id="appName" type="string" value="" onChange="OnLogoChanged" />
    <field id="cPrimary500" type="string" value="0x0b75e0ff" onChange="OnThemeChanged" />
    <field id="cNeutral50" type="string" value="0xf8f1f7ff" onChange="OnThemeChanged" />
    <field id="cNeutral200" type="string" value="0xd4d4d4ff" onChange="OnThemeChanged" />
    <field id="cNeutral800" type="string" value="0x262626ff" onChange="OnThemeChanged" />
    <field id="cNeutral950" type="string" value="0x0a0a0aff" onChange="OnThemeChanged" />
    <field id="scrimOpacity" type="float" value="0.0" onChange="OnScrimOpacityChanged" />
  </interface>

  <script type="text/brightscript" uri="pkg:/components/widgets/HomeHeader.brs" />

  <children>
    <!-- Header tint: a top→bottom black gradient (opaque at the very top, fading to
         transparent) instead of a flat band, so the bar reads as "transparent with a
         subtle black tint" like the LG header rather than a solid black strip. -->
    <Poster id="scrim" width="1920" height="170" uri="pkg:/images/ui/grad_top.png"
      blendColor="0x000000ff" opacity="0.0" loadDisplayMode="scaleToFill" />

    <Poster id="logoPoster" translation="[48, 26]" width="220" height="64"
      loadDisplayMode="scaleToFit" visible="false" />
    <Label id="logoLabel" translation="[48, 32]" width="360" height="52" vertAlign="center"
      color="0xf8f1f7ff" visible="false">
      <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="34" />
    </Label>

    <!-- Plain Group (not LayoutGroup): items are positioned manually at fixed x with
         a 24px gap (space-x-6). A focused item's scale-105 is then purely visual and
         never reflows its neighbors, matching React where transform doesn't affect layout. -->
    <Group id="menuRow" translation="[560, 34]" />

    <!-- Static header avatar (parity with ottHeader.tsx Images.AVATAR). PNGs are
         pre-masked to a circle (rounded-full overflow-hidden). The tint layer is a
         white-mask PNG tinted via blendColor using themeManager primary-500 (same
         pattern as FocusFrame corners + LoginTabButton). -->
    <Group id="avatarHost" translation="[1808, 26]">
      <Poster id="avatarTint" width="64" height="64"
        uri="pkg:/images/ui/header_avatar_tint.png" loadDisplayMode="scaleToFill" />
      <Poster id="avatarDetail" width="64" height="64"
        uri="pkg:/images/ui/header_avatar_detail.png" loadDisplayMode="scaleToFill" />
    </Group>
  </children>
</component>
