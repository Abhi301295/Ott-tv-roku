<?xml version="1.0" encoding="utf-8" ?>
<!-- Logout confirmation overlay (parity with confirmpopup.tsx). The screen forwards
     keys via keyEvent and observes `action` ("cancel" | "logout"). -->
<component name="ConfirmPopup" extends="Group">
  <interface>
    <field id="keyEvent" type="assocarray" alwaysNotify="true" />
    <field id="isLoggingOut" type="boolean" value="false" onChange="OnLoggingOutChanged" />
    <field id="action" type="string" value="" alwaysNotify="true" />
    <!-- theme colors injected by the screen (re-applied when the screen sets them,
         since this component's init() runs before the screen injects tokens) -->
    <field id="cPrimary500" type="string" value="0x0b75e0ff" onChange="OnThemeChanged" />
    <field id="cPrimary600" type="string" value="0x0760bbff" onChange="OnThemeChanged" />
    <field id="cNeutral300" type="string" value="0xc9c9c9ff" onChange="OnThemeChanged" />
    <field id="cNeutral500" type="string" value="0xe279ceff" onChange="OnThemeChanged" />
    <field id="cCardBg" type="string" value="0x171717ff" onChange="OnThemeChanged" />
    <field id="cCardBorder" type="string" value="0xa12189ff" onChange="OnThemeChanged" />
  </interface>

  <script type="text/brightscript" uri="pkg:/components/widgets/ConfirmPopup.brs" />

  <children>
    <Rectangle id="scrim" width="1920" height="1080" color="0x00000080" />

    <Poster id="cardBorder" translation="[630, 390]" width="660" height="300"
      uri="pkg:/images/ui/confirm_border.png" blendColor="0xa12189ff" />
    <Poster id="cardFill" translation="[632, 392]" width="656" height="296"
      uri="pkg:/images/ui/confirm_card.png" blendColor="0x171717ff" />

    <Label id="title" text="Log Out" translation="[630, 432]" width="660"
      horizAlign="center" color="0xf8f1f7ff">
      <Font role="font" uri="pkg:/fonts/DMSans-Bold.ttf" size="36" />
    </Label>
    <Label id="prompt" text="Are you sure you want to Logout?" translation="[630, 500]" width="660"
      horizAlign="center" color="0xc9c9c9ff">
      <Font role="font" uri="pkg:/fonts/DMSans-Regular.ttf" size="20" />
    </Label>

    <!-- Cancel button (shadow = subtle dark drop shadow, parity with shadow-lg) -->
    <Poster id="cancelShadow" translation="[726, 582]" width="224" height="68"
      uri="pkg:/images/ui/popup_btn_shadow.png" blendColor="0x000000ff" opacity="0.35" visible="false" />
    <Poster id="cancelBorder" translation="[728, 568]" width="220" height="64"
      uri="pkg:/images/ui/popup_btn.png" blendColor="0xe279ceff" />
    <Poster id="cancelFill" translation="[730, 570]" width="216" height="60"
      uri="pkg:/images/ui/popup_btn.png" blendColor="0x171717ff" />
    <Label id="cancelLabel" text="Cancel" translation="[728, 568]" width="220" height="64"
      horizAlign="center" vertAlign="center" color="0xf8f1f7ff">
      <Font role="font" uri="pkg:/fonts/DMSans-SemiBold.ttf" size="20" />
    </Label>

    <!-- Log Out button (shadow = subtle dark drop shadow, parity with shadow-lg) -->
    <Poster id="logoutShadow" translation="[970, 582]" width="224" height="68"
      uri="pkg:/images/ui/popup_btn_shadow.png" blendColor="0x000000ff" opacity="0.35" visible="false" />
    <Poster id="logoutBorder" translation="[972, 568]" width="220" height="64"
      uri="pkg:/images/ui/popup_btn.png" blendColor="0xe279ceff" />
    <Poster id="logoutFill" translation="[974, 570]" width="216" height="60"
      uri="pkg:/images/ui/popup_btn.png" blendColor="0x171717ff" />
    <Label id="logoutLabel" text="Log Out" translation="[972, 568]" width="220" height="64"
      horizAlign="center" vertAlign="center" color="0xf8f1f7ff">
      <Font role="font" uri="pkg:/fonts/DMSans-SemiBold.ttf" size="20" />
    </Label>
  </children>
</component>
