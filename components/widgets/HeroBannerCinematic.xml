<?xml version="1.0" encoding="utf-8" ?>
<!-- Cinematic hero — parity with heroBannerCinematic.tsx (85vh, Ken Burns zoom,
     15s auto-swipe, crossfade, gradient overlays, title metadata). Trailers deferred. -->
<component name="HeroBannerCinematic" extends="Group">
  <interface>
    <field id="bannerItems" type="array" onChange="OnBannerItemsChanged" />
    <field id="cNeutral50" type="string" value="0xf8f1f7ff" onChange="OnThemeChanged" />
    <field id="cPrimary500" type="string" value="0x0b75e0ff" onChange="OnThemeChanged" />
  </interface>

  <script type="text/brightscript" uri="pkg:/source/lib/home/HomeConstants.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/home/CardHelper.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/HeroBannerCinematic.brs" />

  <children>
    <Rectangle id="heroBg" width="1920" height="918" color="0x0f1014ff" />

    <Group id="nextLayer" translation="[0, 0]">
      <Group id="nextClip" clippingRect="[0, 0, 1920, 918]" clippingRectClipsChildren="true">
        <Poster id="nextPoster" width="2400" height="918" translation="[-240, 0]"
          loadDisplayMode="scaleToFill" />
      </Group>
    </Group>

    <Group id="activeLayer" translation="[0, 4]">
      <Group id="activeClip" clippingRect="[0, 0, 1920, 918]" clippingRectClipsChildren="true">
        <Poster id="activePoster" width="2400" height="918" translation="[-240, 0]"
          loadDisplayMode="scaleToFill" />
      </Group>
    </Group>

    <!-- Gradient overlays (approximate CSS vignettes from heroBannerCinematic.tsx). -->
    <Rectangle id="leftVignette" width="1248" height="918" color="0x0f1014ff" opacity="0.82" />
    <Rectangle id="bottomVignette" translation="[0, 640]" width="1920" height="278"
      color="0x0f1014ff" opacity="0.72" />
    <Rectangle id="topVignette" width="1920" height="184" color="0x0f1014ff" opacity="0.55" />

    <Group id="metaHost" translation="[64, 500]">
      <Label id="titleLabel" text="" width="700" height="120" wrap="true"
        color="0xf8f1f7ff" horizAlign="left" vertAlign="top">
        <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="56" />
      </Label>
      <Label id="genreLabel" translation="[0, 118]" text="" width="700" height="32"
        color="0xf8f1f7ff" horizAlign="left" vertAlign="center">
        <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="20" />
      </Label>
      <Label id="descLabel" translation="[0, 158]" text="" width="633" height="96" wrap="true"
        color="0xf8f1f7cc" horizAlign="left" vertAlign="top">
        <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="20" />
      </Label>
      <Group id="dotsHost" translation="[0, 270]" />
    </Group>

    <Timer id="swipeTimer" repeat="true" duration="15" />

    <Animation id="fadeAnim" duration="1.2" repeat="false" easeFunction="inOutCubic">
      <FloatFieldInterpolator id="fadeInterp" key="[0.0, 1.0]" keyValue="[1.0, 0.0]"
        fieldToInterp="activeLayer.opacity" />
    </Animation>

    <Animation id="zoomAnim" duration="8" repeat="false" easeFunction="outCubic">
      <Vector2DFieldInterpolator id="zoomInterp" key="[0.0, 1.0]"
        keyValue="[[1.0, 1.0], [1.05, 1.05]]" fieldToInterp="activePoster.scale" />
    </Animation>
  </children>
</component>
